# Documentation only: the application reads process environment, not this file.
# Personal mode reuses Normiq's shared Supabase Auth project:
# copy NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY into the
# SCOPE_SUPABASE_* names below. Never put real values in git.
# SCOPE_NORMIQ_AUTH_URL is the canonical HTTPS origin of the Normiq app whose
# custom passcode API sends the six-digit login code (its Resend template);
# for local development http://127.0.0.1:<port> or http://localhost:<port> is
# permitted. Login codes never use the Supabase Magic Link template.
# Keep shared until the shared project has been verified for Scope.
SCOPE_AUTH_MODE=shared
SCOPE_NORMIQ_AUTH_URL=
SCOPE_SUPABASE_URL=
SCOPE_SUPABASE_ANON_KEY=
SCOPE_OWNER_EMAIL=
SCOPE_PUBLIC_URL=
# Optional (phase 2, Scope-first accounts): the same value as Normiq's
# SCOPE_PROVISIONING_SECRET (32+ printable characters, no spaces). Unset keeps
# phase 1: only people who already have a Normiq account can sign in.
SCOPE_NORMIQ_PROVISIONING_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Scope
# Optional: JSON file of Amtsblatt planning publications for block E, filled by
# `python -m amtsblatt_import <file> <batch>` (contract in amtsblatt_import.py),
# which also records each attempt in <file>.status.json. Leave unset in
# production until the reuse question is settled (NEWSFEED.md §5); block E then
# links to the filtered Amtsblatt search. Check a file first:
# .venv/bin/python -m planning check <file>
SCOPE_PLANNING_PUBLICATIONS=
# Block E's inference path (revisions, statuses of today, zone verdicts, ÖREB
# matching): OFF. Set to 1 only to test it against fixtures — see README.
SCOPE_PLANNING_INFERENCE=

# Optional local preview only: separate reviewed candidate store populated by
# python -m planning_preview import/sync/review/verify. No network work on page
# render; legal badges require separate exact-source verification per municipality.
# No complete-history claims, no preview rows in PDF exports.
# Leave unset in production; see README for explicit local commands.
SCOPE_PLANNING_PREVIEW=

# Prepared metadata scheduler, OFF. Enable only after operational source-reuse
# authorization is obtained and documented; these flags do not grant permission.
# Independent of personal auth/email; no automatic relevance or legal decisions.
# Requires the absolute preview path above and an existing writable directory.
SCOPE_PLANNING_REFRESH_ENABLED=0
SCOPE_PLANNING_REFRESH_MUNICIPALITIES=
# Daily calendar hour in Europe/Zurich (DST included).
SCOPE_PLANNING_REFRESH_HOUR=8
# At most 20 pages/source and 100 search pages/pass; timeout at most 30 seconds.
SCOPE_PLANNING_REFRESH_MAX_PAGES=5
SCOPE_PLANNING_REFRESH_TIMEOUT=20
SCOPE_PLANNING_REUSE_AUTHORIZED=0
SCOPE_PLANNING_REUSE_REFERENCE=
